{ Increments=     
    { Type= ModeleIncremental }     
    { Data=         
        { NomCompteur= CompteurTemps }   
    }     
    { Dependance=        
        { Maillage= MaillagePrincipal }       
        { ModeleAvantDebut=  Initialisateur }   
        { ModeleIncrement= CorpsInc }         
        { ModeleTerminaison= Fin }     
    } 
} 

{ Initialisateur=                                  
    { Type= ModeleDeModeles }
    { Dependance=      
        { Maillage= MaillagePrincipal }  
        { Modele= Interacteur } 
	  	{ Modele= Geometres }

	  	{ Modele= PrepareDragLift } 		
	  	{ Modele= Torque }
		{ Modele= DragLift }

	  	{ Modele= AdaptInit }

        { Modele= IniNuTilde }
        { Modele= RecoverNuTurbIni }
        { Modele= UpdateV }
        { Modele= UpdateNuTilde }

        { Modele= PrepareVitesseRotation } 
	
		{ Modele= Sorties } 		
    } 
}

{ CorpsInc=                                  
    { Type= ModeleDeModeles }     
    { Dependance=  
        { Maillage= MaillagePrincipal } 
        { Modele= Interacteur } 
	
		{ Modele= CLMecanique } 
		
		{ Modele= NavierStokes }

	  	{ Modele= PrepareDragLift } 
		{ Modele= DragLift }
	  	{ Modele= Torque } 

		{ Modele= CLSpalartAllmaras }
		{ Modele= PrepareSpalartAllmaras }
		{ Modele= UpdateV }	

	    { Modele= DeLaFonction }
      	{ Modele= Adaptateur }  // Geometres est appelé à chaque remaillage
	   
	  	{ Modele= Sorties }
		{ Modele= GestionTemps } 		
    } 
} 

{ GestionTemps=
    { Type= ModeleTemporel }     
    { Data=         
        { NomTemps= Temps }         
        { NomPasDeTemps= PasDeTemps }  
    } 
    { DependanceModifiable= 
        { Champ= Temps } 
    } 
    { Dependance=         
        { Maillage= MaillagePrincipal }               
        { Champ= PasDeTemps }  
    } 
} 

{ Fin=                                      // on sort si T = Tfin
    { Type= ModeleFinSurTemps }     
    { Data=         
        { NomTemps= Temps }         
        { NomTempsFin= TempsFin }     
    }     
    { Dependance=         
        { Maillage= MaillagePrincipal }         
        { Champ= Temps }         
        { Champ= TempsFin }     
    } 
} 

{ AdaptInit=                                  
    { Type= ModeleDeModeles }     
    { Dependance=  
        { Maillage= MaillagePrincipal } 
        { Modele= DeLaFonction }
      	{ Modele= Adaptateur }
		{ Modele= Geometres }
		
		{ Modele= DeLaFonction }
      	{ Modele= Adaptateur }
		{ Modele= Geometres }
		
		{ Modele= DeLaFonction }
      	{ Modele= Adaptateur }
		{ Modele= Geometres }
	}
}
