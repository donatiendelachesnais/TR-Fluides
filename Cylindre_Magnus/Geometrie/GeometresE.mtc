{ GeometresE=
    { Type= ModeleDeModeles }
      { Dependance= 
		{ Maillage= MaillagePrincipal }
   
		{ Modele= GeoBord }
        
		{ Modele= DefinitionP1 }
		{ Modele= GeoP1 }
		{ Modele= DistanceP1 }
	  
		{ Modele= DefinitionP2 }
		{ Modele= GeoP2 }
		{ Modele= DistanceP2 }
	  
		{ Modele= DefinitionP3 }
		{ Modele= GeoP3 }
		{ Modele= DistanceP3 }
	  
		{ Modele= DefinitionP4 }
		{ Modele= GeoP4 }
		{ Modele= DistanceP4 }
	  
		{ Modele= DefinitionP5 }
		{ Modele= GeoP5 }
		{ Modele= DistanceP5 }
		
		{ Modele= DefinitionP6 }
		{ Modele= GeoP6 }
		{ Modele= DistanceP6 }
		
		{ Modele= DefinitionP7 }
		{ Modele= GeoP7 }
		{ Modele= DistanceP7 }
		
		{ Modele= CalculAlpha }
		{ Modele= CalculLevelSet_Cylinder_MoinsUn }
    }
}

{ GeoBord=
    { Type= ModeleDeGeometres }
    { Data=
        { Geometre= 
            { Type= GeometreChamp }
            { Data=
                { Champ= BordNoeud }
                { ValeurSeuilMin= 0.999999 }
                { ValeurSeuilMax= 1.000001 }
            }
        }
    }
    { Dependance=
        { Maillage= MaillagePrincipal }
    }
}

