{ CalculAlpha=
   { Type= ModeleParticulaire }
   { Data=	
      { ItemSolveur=
         { Type= ISfonctionTC }
 		 { Passe= 9 }
         { NbChampSolution= 1 }
         { ChampSolution= Alpha }
         { NbChampParametre= 3 }
         { ChampParametre= LevelSet_Cylinder Lmin Lmax }
      }
   }
   { DependanceModifiable=
       { Champ= Alpha }
   }
   { Dependance=
      { Maillage= MaillagePrincipal }
      { Champ= LevelSet_Cylinder }
      { Champ= Lmax }
      { Champ= Lmin }
   }
}

{ CalculLevelSet_Cylinder_MoinsUn=
    { Type= ModeleArithmetique }
    { Dependance= 
        { Maillage= MaillagePrincipal }
        { Champ= MoinsUn }
        { Champ= LevelSet_Cylinder }
    }
    { DependanceModifiable= 
        { Champ= LevelSet_Cylinder_MoinsUn }
    }
    { Operation= LevelSet_Cylinder_MoinsUn = LevelSet_Cylinder }
    { Operation= LevelSet_Cylinder_MoinsUn *= MoinsUn }
}