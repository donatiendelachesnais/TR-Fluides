}

{ CalculV=
    { Type= ModeleArithmetique }
        { Data=
				{ Champ=
                        { Type= P0C_Scalaire_Par }
                        { Nom= U }
                        { Data= ValeurItem 1 0.3 }
				}
                { Champ=
                        { Type= P0C_Scalaire_Par }
                        { Nom= A }
                        { Data= ValeurItem 1 23.7953599 }
                }
                { Champ=
                        { Type= P0C_Scalaire_Par }
                        { Nom= H }
                        { Data= ValeurItem 1 0.41 }
                }
                { Champ=
                        { Type= P1_Scalaire_Par }
                        { Nom= V }
                        { Data= ValeurItem 1 0 }
                }
        }
        { Dependance=
                { Maillage= MaillagePrincipal }
                { Champ= U }
                { Champ= A }
                { Champ= H }
                { Champ= Ordonnee }
        }
        { DependanceModifiable=
                { Champ= V }  
		}
        { Operation= V = H  }
		{ Operation= V -= Ordonnee }
        { Operation= V *= A }
        { Operation= V *= U }
        { Operation= V *= Ordonnee } 
}