{ Preparedxdydz=
    { Type= ModeleArithmetique }
    { Dependance= 
        { Maillage= MaillagePrincipal }
		{ Champ= Cox }
		{ Champ= Coy }
		{ Champ= Coz }
		{ Champ= x0 }
		{ Champ= y0 }
		{ Champ= z0 }
    }
    { DependanceModifiable= 
        { Champ= dx }
		{ Champ= dy }
		{ Champ= dz }
    }

	{ Operation= dx += Cox }
	{ Operation= dx -= x0 }
    { Operation= dy += Coy }
	{ Operation= dy -= y0 }
    { Operation= dz += Coz }
    { Operation= dz -= z0 }
}

{ Preparedxy=
    { Type= ModeleArithmetique }
    { Dependance= 
        { Maillage= MaillagePrincipal }
		{ Champ= dx }
		{ Champ= dy }
        { Champ= dx2 }
		{ Champ= dy2 }
		{ Champ= Deux }
		{ Champ= Undemi }

    }
    { DependanceModifiable= 
        { Champ= dx2 }
		{ Champ= dy2 }
		{ Champ= dxy }
    }
	
	{ Operation= dx2 += dx }		
    { Operation= dx2 **= Deux }
	{ Operation= dy2 += dy }
	{ Operation= dy2 **= Deux }
	{ Operation= dxy += dx2 }	
	{ Operation= dxy += dy2 }			
    { Operation= dxy **= Undemi }
}

{ PrepareRepereTourne=
    { Type= ModeleArithmetique }
    { Data=
        { Champ=
            { Type= P1_Scalaire_Par }
            { Nom= dX }
			{ Data= ValeurItem 1 0 }
        }
        { Champ=
            { Type= P1_Scalaire_Par }
            { Nom= dY }
            { Data= ValeurItem 1 0 }
        }
        { Champ=
            { Type= P1_Scalaire_Par }
            { Nom= dZ }
            { Data= ValeurItem 1 0 }
        }
        { Champ=
            { Type= P1_Scalaire_Par }
            { Nom= theta }
            { Data= ValeurItem 1 0.262}
        }
        { Champ=
            { Type= P1_Scalaire_Par }
            { Nom= SinTheta }
            { Data= ValeurItem 1 0 }
        }
        { Champ=
            { Type= P1_Scalaire_Par }
            { Nom= CosTheta }
            { Data= ValeurItem 1 0 }
        }
        { Champ=
            { Type= P1_Scalaire_Par }
            { Nom= VarMuette }
            { Data= ValeurItem 1 0 }
        }
    }
    { Dependance= 
        { Maillage= MaillagePrincipal }
		{ Champ= dx }
		{ Champ= dy }
		{ Champ= dz }
		{ Champ= theta }
        { Champ= SinTheta }
        { Champ= CosTheta }
        { Champ= VarMuette }
    }
    { DependanceModifiable= 
        { Champ= dX }
        { Champ= dY }
        { Champ= dZ }
        { Champ= SinTheta }
        { Champ= CosTheta }
        { Champ= VarMuette }
    } 

    { Operation= CosTheta Cos theta }
	{ Operation= SinTheta Sin theta }


	{ Operation= dX = dx }
    { Operation= dX *= CosTheta }
    { Operation= VarMuette = dy }
    { Operation= VarMuette *= SinTheta }
    { Operation= dX += VarMuette }

    { Operation= dY = dy }
    { Operation= dY *= CosTheta }
    { Operation= VarMuette = dx }
    { Operation= VarMuette *= SinTheta }
    { Operation= dY -= VarMuette }

    { Operation= dZ = dz }
}

{ PrepareVxVyVz=
    { Type= ModeleArithmetique }
    { Dependance= 
        { Maillage= MaillagePrincipal }
		{ Champ= dX }
		{ Champ= dY }
        { Champ= dZ }
        { Champ= CosTheta }        
        { Champ= SinTheta }        
		{ Champ= omega }
    }
    { DependanceModifiable= 
        { Champ= Vx }
		{ Champ= Vy }
        { Champ= Vz }
    }

    { Operation= Vx -= dZ }
	{ Operation= Vx *= omega }
	{ Operation= Vx *= CosTheta }

    { Operation= Vy -= dZ }
	{ Operation= Vy *= omega }
	{ Operation= Vy *= SinTheta }

    { Operation= Vz = dX }
    { Operation= Vz *= omega }
}