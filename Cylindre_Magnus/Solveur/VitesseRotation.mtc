{ ExtraireCox= 
    { Type= ModeleParticulaire }
    { Data=
        { Champ=
            { Type= P1_Scalaire_Par }
            { Nom= Cox }
            { Data= ValeurItem 1 0 }
        }
        { ItemSolveur=
            { Type= ISExtraire }
            { NbChampSolution= 1 }
            { ChampSolution= Cox }
            { NbChampParametre= 1 }
            { ChampParametre= Coordonnees }
            { Composante= 0 }
        }
    }
    { Dependance=
        { Maillage= MaillagePrincipal }
        { Champ= Coordonnees }
    }
}

