{ NavierStokes=
	{ Type= ModeleElementsFinis }
	{ Data=
		{ Champ= 
			{ Type= P1_Vecteur_Par }
			{ Nom= Vitesse }
			{ Data: Dimension/vecteur.txt }  	
		}
		{ Champ= 
			{ Type= P1_Vecteur_Par }
			{ Nom= VitesseMoins }
			{ Data: Dimension/vecteur.txt }	
	    }
		{ Champ= 
			{ Type= P1_Vecteur_Par }
			{ Nom= VitesseMoinsMoins }
			{ Data: Dimension/vecteur.txt }	
		}
		{ Champ= 
			{ Type= P1_Scalaire_Par }
			{ Nom= Pression }
			{ Data= ValeurItem 1 0.0 }
	    }
		{ Champ= 
			{ Type= P1_Vecteur_Par }
			{ Nom= ZeroVecteur }
			{ Data: Dimension/vecteur.txt }
	    }
		{ Champ= 
			{ Type= P1_Tenseur_Par }
			{ Nom= ZeroTenseur }
			{ Data: Dimension/tenseur.txt }
	    }
		{ Champ= 
			{ Type= P1_Vecteur_Par }
			{ Nom= VectorD }
			{ Data: Dimension/vecteurx.txt }
		}
		{ Champ= 
			{ Type= P1_Vecteur_Par }
			{ Nom= VectorL }
			{ Data: Dimension/vecteury.txt }
		}
		{ SolveurLocal=
			{ Type= NavierStokesVMS }
			{ Resolution= 12  }  
			{ Preconditionneur= 20 } 
			{ NbChampParametre= 9 }
			{ ChampParametre= NuTurb ZeroVecteur Vitesse VitesseMoins Rho1 PasDeTemps ZeroVecteur ZeroTenseur ZeroVecteur }
			{ NbChampSolution= 2 }
			{ ChampSolution= Vitesse Pression }
			{ Newton= 0.5 }	
		}
		{ Solveur= 
			{ Type= SolveurLineaire }
			{ TypeDeNorme= 1 }
			{ Precision= 1e-6 }
		}
	}
	{ Dependance=
		{ Champ= Gravite }
		{ Champ= ZeroVecteur }
		{ Champ= ZeroTenseur }
		{ Champ= Vitesse }
		{ Champ= VitesseMoins }
		{ Champ= PasDeTemps }
		{ Champ= Eta1 }
		{ Champ= Rho1 }
		{ Champ= Zero }
		{ Champ= NuTurb }
		{ Maillage= MaillagePrincipal }
		{ ModeleCL= CLMecanique } 
	}
}

{ UpdateV=
    { Type= ModeleArithmetique }
    { Dependance= 
        { Maillage= MaillagePrincipal }
        { Champ= Vitesse }
    }
    { DependanceModifiable= 
        { Champ= VitesseMoins }
		{ Champ= VitesseMoinsMoins }
    }
	{ Operation= VitesseMoinsMoins = VitesseMoins }
	{ Operation= VitesseMoins = Vitesse }
}
 
