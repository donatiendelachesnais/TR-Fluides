{ SpalartAllmarasTest=
   { Type= ModeleParticulaire }
   { Data=
        { ItemSolveur=
            { Type= ISSpalartAllmaras } 
            { Dimension= 3 } 
            { NbChampSolution= 5 }
            { ChampSolution= Convection Diffusion Reaction Damp denv }
            { NbChampParametre= 9 }
			{ TypeDeLoi= SAneg }  // SAneg
            { ChampParametre= Vitesse OmegaVitesse NuTilde GradNuTilde LevelSet_Cylinder Eta1 Rho1 DistMin MeshSize } 
        }
	
    }
	
    { Dependance=
        { Maillage= MaillagePrincipal }
        { Champ= Vitesse }
        { Champ= OmegaVitesse }
		{ Champ= NuTilde }
		{ Champ= GradNuTilde }
		{ Champ= LevelSet_Cylinder }
		{ Champ= DistMin }
        { Champ= Eta1 }
        { Champ= Rho1 }
        { Champ= MeshSize }
    }
	{ DependanceModifiable=
        { Champ= Convection }
        { Champ= Diffusion }
		{ Champ= Reaction }
		{ Champ= Damp }
		{ Champ= denv }
    }
}


{ CalculVorticite=
	{ Type= ModeleFonctionnel }
	{ Data=
	   { SimplexSolveurFonctionnel=
			{ Type= SsfVorticite }
			{ NbChampSolution= 1 }
			{ ChampSolution= OmegaVitesseP0 }
			{ NbChampParametre= 1 }
			{ ChampParametre= Vitesse }
		}
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= Vitesse }
	}
}
 
{ CalculOmegaP1=
	{ Type= ModeleFonctionnel }
	{ Data=
		{ SimplexSolveurFonctionnel=
			{ Type= SsfTest }
			{ NbChampSolution= 1 }
			{ ChampSolution= OmegaVitesse }
			{ OperationsP1=
				{ NbChampsP1= 1 }
				{ Numero= 0 }
				{ Initialise= 0.0 }
				{ Operateur= += }
				{ Moyenner= 1 }
			}
			{ NbChampParametre= 1 }
			{ ChampParametre= OmegaVitesseP0 }
		}
	}
	{ DependanceModifiable= 
		{ Champ= OmegaVitesse }
	}
	{ Dependance=
      { Maillage= MaillagePrincipal }
      { Champ= OmegaVitesseP0 }
	}
}

{ ComputeGrad=
	{ Type= ModeleFonctionnel }
	{ Data=
		{ SimplexSolveurFonctionnel=
			{ Type= SsfGradient }
			{ NbChampSolution= 1 }
			{ ChampSolution= GradNuTildeP0 }
			{ NbChampParametre= 1 }
			{ ChampParametre= NuTilde }
		}
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= NuTilde }
	}
 }
 
{ IniNuTilde=
	{ Type= ModeleArithmetique }
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= Eta1 }
		{ Champ= GammaSA }		
	}
	{ DependanceModifiable=
		{ Champ= NuTilde }
		{ Champ= NuTildeIn }
		
	}

	{ Operation= NuTildeIn = Eta1 }
	{ Operation= NuTildeIn *= GammaSA }	
	{ Operation= NuTilde = NuTildeIn }
}

{ RecoverNuTurbIni=
	{ Type= ModeleArithmetique }
	{ Data=
		{ Champ= 
			{ Type= P0C_Scalaire_Par } 
			{ Nom= Trois } 		
			{ Data= ValeurItem 1 3.0 } 
		}
		{ Champ=             
			{ Type= P1_Scalaire_Par }             
			{ Nom= Chi }             
			{ Data= ValeurItem 1 0.0 }         
		}	
		{ Champ=             
			{ Type= P1_Scalaire_Par }             
			{ Nom= ChiExp3 }             
			{ Data= ValeurItem 1 0.0 }         
		}			
		{ Champ=             
			{ Type= P0C_Scalaire_Par }             
			{ Nom= Cv1Exp3 }             
			{ Data= ValeurItem 1 357.911 }         
		}
		{ Champ=             
			{ Type= P1_Scalaire_Par }             
			{ Nom= aux }             
			{ Data= ValeurItem 1 0.0 }         
		}			
	}
	
	{ Operation= Chi = NuTilde }
	{ Operation= Chi /= Eta1 }
	{ Operation= Chi *= Rho1 }

	{ Operation= ChiExp3 = Chi }
	{ Operation= ChiExp3 **= Trois }

	{ Operation= aux = ChiExp3 }
	{ Operation= aux += Cv1Exp3 }

	{ Operation= fv1 = ChiExp3 }
	{ Operation= fv1 /= aux }

	{ Operation= NuTurb = fv1 }
	{ Operation= NuTurb *= NuTilde }
	
	{ Operation= NuTurb > Zero }
	{ Operation= NuTurb += Eta1 }
	{ Operation= NuTurb *= Rho1 }	
	
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= NuTilde }
		{ Champ= Zero }
		{ Champ= Trois }						
		{ Champ= Eta1 }
		{ Champ= Rho1 }	
		{ Champ= Cv1Exp3 }			
	}
	{ DependanceModifiable=
		{ Champ= Chi }
		{ Champ= ChiExp3 }		
		{ Champ= fv1 }	
		{ Champ= aux }		
		{ Champ= NuTurb }
	}
}
 
{ CalculGradNuTilde=
   { Type= ModeleFonctionnel }
   { Data=
      { SimplexSolveurFonctionnel=
         { Type= SsfTest }
         { NbChampSolution= 1 }
         { ChampSolution= GradNuTilde }
         { OperationsP1=
            { NbChampsP1= 1 }
               { Numero= 0 }
               { Initialise= 0.0 }
               { Operateur= += }
               { Moyenner= 1 }
			}
       { NbChampParametre= 1 }
       { ChampParametre= GradNuTildeP0 }
	  }
    }
	{ DependanceModifiable= 
		{ Champ= GradNuTilde }
	}
	{ Dependance=
      { Maillage= MaillagePrincipal }
      { Champ= GradNuTildeP0 }
	}
}

{ RecoverNuTurb=
	{ Type= ModeleArithmetique }
	
	{ Operation= NuTurb = Damp }
	{ Operation= NuTurb *= NuTilde }
	
	{ Operation= NuTurb > Zero }
	{ Operation= NuTurb += Eta1 }
	{ Operation= NuTurb *= Rho1 }	
	
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= NuTilde }
		{ Champ= Cv1Puiss3 }
		{ Champ= Damp }
		{ Champ= Zero }
		{ Champ= Eta1 }
		{ Champ= Rho1 }		
	}
	{ DependanceModifiable=

		{ Champ= NuTurb }
	}
}

