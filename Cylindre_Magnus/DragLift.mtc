}

{ NormeTorque=
   { Type= ModeleParticulaire }
   { Data=
		{ ItemSolveur=
			{ Type= ISNorme }
			{ NbChampSolution= 1 }
			{ ChampSolution= Torque }
			{ NbChampParametre= 1 }
			{ ChampParametre= TvectInteg }
		}
   }
   { Dependance=
      { Maillage= MaillagePrincipal }
      { Champ= TvectInteg }
   }
}

{ EcrireTvect=
	{ Type= ModeleCapteur }
	{ Data=
		{ NomFichier= Resultats/Torque }
		{ Precision= 15 }
		{ NbCapteurs= 0 }
		{ HAdaptation= 1 }
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= Temps }
		{ Champ= TvectInteg }
		{ Champ= Torque }
	}
}

