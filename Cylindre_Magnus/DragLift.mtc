{ PrepareDragLift=
	{ Type= ModeleDeModeles }
	{ Data=
		{ Champ= { Type= P0C_Vecteur_Par }	{ Nom= exVecteurRef }		{ Data= ValeurItem 3 1 0 0 } }
		{ Champ= { Type= P0C_Vecteur_Par }	{ Nom= eyVecteurRef }		{ Data= ValeurItem 3 0 1 0 } }
		{ Champ= { Type= P0C_Vecteur_Par }	{ Nom= ezVecteurRef }		{ Data= ValeurItem 3 0 0 1 } }

		{ Champ= { Type= P1_Vecteur_Par }	{ Nom= exVecteur }		{ Data= ValeurItem 3 1 0 0 } }
		{ Champ= { Type= P1_Vecteur_Par }	{ Nom= eyVecteur }		{ Data= ValeurItem 3 0 1 0 } }
		{ Champ= { Type= P1_Vecteur_Par }	{ Nom= ezVecteur }		{ Data= ValeurItem 3 0 0 1 } }

		{ Champ= { Type= P0C_Scalaire_Par }	{ Nom= RhoRef }			{ Data= ValeurItem 1 1 } }
		{ Champ= { Type= P0C_Scalaire_Par }	{ Nom= VRef }			{ Data= ValeurItem 1 3 } }
		{ Champ= { Type= P0C_Scalaire_Par }	{ Nom= SRef }			{ Data= ValeurItem 1 0.0200025 } }
		{ Champ= { Type= P0C_Scalaire_Par }	{ Nom= ForceRef }		{ Data= ValeurItem 1 0 } }
		{ Champ= { Type= P0C_Scalaire_Par }	{ Nom= UnSurForceRef }	{ Data= ValeurItem 1 0 } }
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Modele= CalcForceDir }
		{ Modele= CalcForceRef }
	}
}

{ CalcForceDir=
	{ Type= ModeleArithmetique }
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= exVecteurRef }
		{ Champ= eyVecteurRef }
		{ Champ= ezVecteurRef }
		{ Champ= Appartient_Cylinder }
		{ Champ= MoinsUn }
	}
	{ DependanceModifiable=
		{ Champ= exVecteur }
		{ Champ= eyVecteur }
		{ Champ= ezVecteur }
	}
	
	{ Operation= exVecteur = exVecteurRef }
	{ Operation= exVecteur *= Appartient_Cylinder }
	{ Operation= exVecteur *= MoinsUn }
	
	{ Operation= eyVecteur = eyVecteurRef }
	{ Operation= eyVecteur *= Appartient_Cylinder }
	{ Operation= eyVecteur *= MoinsUn }
	
	{ Operation= ezVecteur = ezVecteurRef }
	{ Operation= ezVecteur *= Appartient_Cylinder }
	{ Operation= ezVecteur *= MoinsUn }
}

{ CalcForceRef=
	{ Type= ModeleArithmetique }
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= RhoRef }
		{ Champ= Vin }
		{ Champ= SRef }
		{ Champ= Un }
		{ Champ= Deux }
	}
	{ DependanceModifiable=
		{ Champ= ForceRef }
		{ Champ= UnSurForceRef }
	}
	
	{ Operation= ForceRef = RhoRef }
	{ Operation= ForceRef *= Vin }
	{ Operation= ForceRef *= Vin }
	{ Operation= ForceRef /= Deux }
	
	{ Operation= ForceRef *= SRef }
	
	{ Operation= UnSurForceRef = Un }
	{ Operation= UnSurForceRef /= ForceRef }
}

{ DragLift=
	{ Type= ModeleDeModeles }
	{ Data=
		{ Champ= { Type= P0C_Scalaire_Par }	{ Nom= IsBDF2 }			{ Data= ValeurItem 1 0 } }
		{ Champ= { Type= P0_Scalaire_Par }	{ Nom= Cx }				{ Data= ValeurItem 1 0 } }
		{ Champ= { Type= P0_Scalaire_Par }	{ Nom= Cy }				{ Data= ValeurItem 1 0 } }
		{ Champ= { Type= P0_Scalaire_Par }	{ Nom= Cz }				{ Data= ValeurItem 1 0 } }

		{ Champ= { Type= P0_Vecteur_Par }	{ Nom= Cvect }			{ Data= ValeurItem 3 0 0 0 } }
		{ Champ= { Type= P0C_Vecteur_Par }	{ Nom= CvectInteg }		{ Data= ValeurItem 3 0 0 0 } }
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Modele= CalcCx }
		{ Modele= CalcCy }
		{ Modele= CalcCz }
		{ Modele= CalcCvect }
		{ Modele= IntegreCvect }
		{ Modele= NormaliseCvect }
		{ Modele= EcrireCvect }
	}
}

{ CalcCx=
	{ Type= ModeleConditionnel }
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ ChampCondition= IsBDF2 }
		{ ModeleFalse= CalcCx1 }
		{ ModeleTrue= CalcCx2 }
	}
}

{ CalcCy=
	{ Type= ModeleConditionnel }
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ ChampCondition= IsBDF2 }
		{ ModeleFalse= CalcCy1 }
		{ ModeleTrue= CalcCy2 }
	}
}

{ CalcCz=
	{ Type= ModeleConditionnel }
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ ChampCondition= IsBDF2 }
		{ ModeleFalse= CalcCz1 }
		{ ModeleTrue= CalcCz2 }
	}
}

{ CalcCx1=
	{ Type= ModeleFonctionnel }
	{ Data=
		{ SimplexSolveurFonctionnel=
			{ Type= SsfDragLift }
			{ BDF= 1 }
			{ NbChampSolution= 1 }
			{ ChampSolution= Cx }
			{ NbChampParametre= 7 }
			{ ChampParametre= Pression Eta1 Vitesse VitesseMoins exVecteur PasDeTemps Un }
		}
		{ Boucle= Volume }
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= Vitesse }
		{ Champ= VitesseMoins }
		{ Champ= PasDeTemps }
		{ Champ= Pression }
		{ Champ= exVecteur }
		{ Champ= Eta1 }
		{ Champ= Un }
	}
	{ DependanceModifiable=
		{ Champ= Cx }
	}
}

