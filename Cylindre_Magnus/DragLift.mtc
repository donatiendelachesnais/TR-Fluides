{ CalcCvect=
	{ Type= ModeleParticulaire }
	{ Data=
		{ ItemSolveur=
			{ Type= ISConcatenation }
			{ NbChampSolution= 1 }
			{ ChampSolution= Cvect }
			{ NbChampParametre= 3 }
			{ ChampParametre= Cx Cy Cz }
		}
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= Cx }
		{ Champ= Cy }
		{ Champ= Cz }
	}
	{ DependanceModifiable=
		{ Champ= Cvect }
	}
}

{ IntegreCvect=
	{ Type= ModeleParticulaire }
	{ Data=
		{ Boucle= Volume }
		{ ItemSolveur=
			{ Type= ISSomme }
			{ Operations=
				{ Initialise= Zero }
			}
			{ NbChampSolution= 1 }
			{ ChampSolution= CvectInteg }
			{ NbChampParametre= 1 }
			{ ChampParametre= Cvect }
		}
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= Cvect }
		{ Champ= Zero }
	}
	{ DependanceModifiable=
		{ Champ= CvectInteg }
	}
}

{ NormaliseCvect=
	{ Type= ModeleParticulaire }
	{ Data=
		{ ItemSolveur=
			{ Type= ISProduit }
			{ TermeATerme= 1 }
			{ NbChampSolution= 1 }
			{ ChampSolution= CvectInteg }
			{ NbChampParametre= 2 }
			{ ChampParametre= CvectInteg UnSurForceRef }
		}
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= UnSurForceRef }
	}
	{ DependanceModifiable=
		{ Champ= CvectInteg }
	}
}

{ EcrireCvect=
	{ Type= ModeleCapteur }
	{ Data=
		{ NomFichier= Resultats/DragLift }
		{ Precision= 15 }
		{ NbCapteurs= 0 }
		{ HAdaptation= 1 }
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= Temps }
		{ Champ= CvectInteg }
		// { Champ= CvectAvg }
		// { Champ= CvectRMS }
		{ Champ= ForceRef }
		{ Champ= RhoRef }
		{ Champ= Vin }
		{ Champ= SRef }
	}
}


{ Torque=
	{ Type= ModeleDeModeles }
	{ Data=
		{ Champ= { Type= P0_Vecteur_Par }	{ Nom= Tvect }	{ Data= ValeurItem 3 0 0 0 } }
		{ Champ= { Type= P0C_Vecteur_Par }	{ Nom= TvectInteg }	{ Data= ValeurItem 3 0 0 0 } }
		{ Champ= { Type= P0C_Scalaire_Par }	{ Nom= Torque }	{ Data= ValeurItem 1 0 } }
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Modele= CalculCmBeam0 }
		{ Modele= CalcTvect }
		{ Modele= IntegreTvect }
		{ Modele= NormeTorque }
		{ Modele= EcrireTvect }
	}
}

{ CalculCmBeam0=
	{ Type= ModeleFonctionnel }
	{ Data=
		{ Champ= { Type= P1_Vecteur_Par } { Nom= CoordonneesCBeam0 } { Data= ValeurItem 3 4 7.5 0 } }
		{ Champ= { Type= P1_Scalaire_Par } { Nom= NSSourceTerm } { Data= ValeurItem 1 0.0 } }
		{ Champ= { Type= P0_Scalaire_Par } { Nom= CmxBeam0 } { Data= ValeurItem 1 0.0 } }
		{ Champ= { Type= P0_Scalaire_Par } { Nom= CmyBeam0 } { Data= ValeurItem 1 0.0 } }
		{ Champ= { Type= P0_Scalaire_Par } { Nom= CmzBeam0 } { Data= ValeurItem 1 0.0 } }

		{ SimplexSolveurFonctionnel=
			{ Type= SsfTorque }
			{ NbChampSolution= 3 }
			{ ChampSolution= CmxBeam0 CmyBeam0 CmzBeam0 }
			{ NbChampParametre= 12 } 
			{ ChampParametre= Pression Eta1 Vitesse VitesseMoins PasDeTemps Un NSSourceTerm Coordonnees CoordonneesCBeam0 exVecteur eyVecteur ezVecteur }
		}
		{ Boucle= Volume }
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= Vitesse }
		{ Champ= VitesseMoins }
		{ Champ= PasDeTemps }
		{ Champ= Pression }
		{ Champ= Zero }
		{ Champ= Un }
		{ Champ= exVecteur }
		{ Champ= eyVecteur }
		{ Champ= ezVecteur }
		{ Champ= Eta1 }
		{ Champ= NSSourceTerm }
		{ Champ= Coordonnees }
		{ Champ= CoordonneesCBeam0 }
	}
	{ DependanceModifiable=
		{ Champ= CmxBeam0 }
		{ Champ= CmyBeam0 }
		{ Champ= CmzBeam0 }
	}
}

{ CalcTvect=
	{ Type= ModeleParticulaire }
	{ Data=
		{ ItemSolveur=
			{ Type= ISConcatenation }
			{ NbChampSolution= 1 }
			{ ChampSolution= Tvect }
			{ NbChampParametre= 3 }
			{ ChampParametre= CmxBeam0 CmyBeam0 CmzBeam0 }
		}
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= CmxBeam0 }
		{ Champ= CmyBeam0 }
		{ Champ= CmzBeam0 }
	}
	{ DependanceModifiable=
		{ Champ= Tvect }
	}
}

{ IntegreTvect=
	{ Type= ModeleParticulaire }
	{ Data=
		{ Boucle= Volume }
		{ ItemSolveur=
			{ Type= ISSomme }
			{ Operations=
				{ Initialise= Zero }
			}
			{ NbChampSolution= 1 }
			{ ChampSolution= TvectInteg }
