{ PrepareDxDy=
    { Type= ModeleArithmetique }
    { Dependance= 
        { Maillage= MaillagePrincipal }
        { Champ= Un }
		{ Champ= Zero }
		{ Champ= Cox }
		{ Champ= Coy }
		{ Champ= Dx }
		{ Champ= Dy }
		{ Champ= y0 }
		{ Champ= x0 }
		{ Champ= omega }
    }
    { DependanceModifiable= 
        { Champ= Dx }
		{ Champ= Dy }
    }

    { Operation= Dx += Coy }
	{ Operation= Dx -= y0 }		
	{ Operation= Dx *= omega }		
	{ Operation= Dy += x0 }
	{ Operation= Dy -= Cox }
	{ Operation= Dy *= omega }
}
