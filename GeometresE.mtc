{ CalculAlpha=
   { Type= ModeleParticulaire }
   { Data=	
      { ItemSolveur=
         { Type= ISfonctionTC }
 		 { Passe= 9 }
         { NbChampSolution= 1 }
         { ChampSolution= Alpha }
         { NbChampParametre= 3 }
         { ChampParametre= LevelSetEntree9 Lmin Lmax }
      }
   }
   { DependanceModifiable=
       { Champ= Alpha }
   }
   { Dependance=
      { Maillage= MaillagePrincipal }
      { Champ= LevelSetEntree9  }
      { Champ= Lmax }
      { Champ= Lmin }
   }
}

