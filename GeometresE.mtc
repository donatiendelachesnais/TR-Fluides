
{ GeometresE=
    { Type= ModeleDeModeles }
      { Dependance= 
        
      { Maillage= MaillagePrincipal }
   
      { Modele= GeoBord }
        
      { Modele= DefinitionP1 }
      { Modele= GeoP1 }
      { Modele= DistanceP1 }
	  
	  { Modele= DefinitionP3 }
      { Modele= GeoP3 }
      { Modele= DistanceP3 }
	  
	  { Modele= DefinitionP4 }
      { Modele= GeoP4 }
      { Modele= DistanceP4 }
  
	  { Modele= DefinitionP8 }
      { Modele= GeoP8 }
      { Modele= DistanceP8 }
	  
	  { Modele= DefinitionP9 }
      { Modele= GeoP9 }
      { Modele= DistanceP9 }
	  
      { Modele= CalculAlpha }
	  
    }
}

{ GeoBord=
    { Type= ModeleDeGeometres }
    { Data=
        { Geometre= 
            { Type= GeometreChamp }
            { Data=
                { Champ= BordNoeud }
                { ValeurSeuilMin= 0.999999 }
                { ValeurSeuilMax= 1.000001 }
            }
        }
    }
    { Dependance=
        { Maillage= MaillagePrincipal }
    }
}

