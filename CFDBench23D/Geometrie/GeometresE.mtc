{ GeometresE=
    { Type= ModeleDeModeles }
      { Dependance= 
		{ Maillage= MaillagePrincipal }
   
		{ Modele= GeoBord }
        
		{ Modele= DefinitionP1 }
		{ Modele= GeoP1 }
		{ Modele= DistanceP1 }
	  
		{ Modele= DefinitionP2 }
		{ Modele= GeoP2 }
		{ Modele= DistanceP2 }
	  
		{ Modele= DefinitionP3 }
		{ Modele= GeoP3 }
		{ Modele= DistanceP3 }
	  
		{ Modele= DefinitionP4 }
		{ Modele= GeoP4 }
		{ Modele= DistanceP4 }
	  
		{ Modele= DefinitionP5 }
		{ Modele= GeoP5 }
		{ Modele= DistanceP5 }
    }
}

{ GeoBord=
    { Type= ModeleDeGeometres }
    { Data=
        { Geometre= 
            { Type= GeometreChamp }
            { Data=
                { Champ= BordNoeud }
                { ValeurSeuilMin= 0.999999 }
                { ValeurSeuilMax= 1.000001 }
            }
        }
    }
    { Dependance=
        { Maillage= MaillagePrincipal }
    }
}

{ DefinitionP1=
    { Type= ModeleDeMouvements }
    { Data=
        { Repere=
            { Dimension= 2 } 
            { Nom= Entree1 }
            { Origine= 0.0 0.0 } 
            { Normale= 1.0 0.0 } 
        }
    }
    { Dependance= 
        { Maillage= MaillagePrincipal }
    }
}

{ GeoP1=
    { Type= ModeleDeGeometres }
    { Data=
		{ Geometre= 
			{ Nom= MUR1 }
			{ Type= GeometreAnalytique }
			{ Data=
				{ Forme= 
					{ Dimension= 2 } 
					{ Type= DemiPlan }							
				}
				{ Repere= Entree1 }
			}
		}
    }
    { Dependance=
        { Maillage= MaillagePrincipal }
        { Modele= DefinitionP1 }
    }
}

{ DistanceP1=
	{ Type= ModeleParticulaire }
	{ Data=
		{ Champ= 
			{ Type= P1_Scalaire_Par }
			{ Nom= LevelSetEntree1 }
			{ Data= ValeurItem 1 0.0 }                        // ##
		}
		{ Champ= 
			{ Type= P1_Scalaire_Par }
			{ Nom= AppartientEntree1 }
			{ Data= ValeurItem 1 0.0 }                        // ##
		}
		{ ItemSolveur=
			{ Type= ISGeometre }
			{ NbChampSolution= 2 }
			{ ChampSolution= AppartientEntree1 LevelSetEntree1 }
			{ NbChampParametre= 2 }
			{ ChampParametre= Coordonnees PrecisionFrontieres }
			{ Geometre= MUR1 }
			{ Distance= 1 }
			{ Appartient= 1 }
		}
	}
	{ Dependance=
		{ Maillage= MaillagePrincipal }
		{ Champ= Coordonnees }
		{ Champ= PrecisionFrontieres }
	}
}

