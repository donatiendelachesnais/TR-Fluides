
{ Increments=     

    { Type= ModeleIncremental }     
    { Data=         
        { NomCompteur= CompteurTemps }   
    }     
    { Dependance=        
        { Maillage= MaillagePrincipal }       
        { ModeleAvantDebut=  Initialisateur }   
        { ModeleIncrement= CorpsInc }         
        { ModeleTerminaison= Fin }     

    } 
} 



{ Initialisateur=                                  
    { Type= ModeleDeModeles }
    { Dependance=      
        { Maillage= MaillagePrincipal }	
        { Modele= Interacteur } 
	  	{ Modele= Geometres } 
		{ Modele= InitialTemperature }
		{ Modele= UpdateT }
		
		{ Modele= ExtraireCox }
		{ Modele= ExtraireCoy }
		{ Modele= PrepareDxDy }
		{ Modele= Melange }
		{ Modele= Sorties }    
		

    } 
}



{ CorpsInc=                                  
    { Type= ModeleDeModeles }     
    { Dependance=  
        { Maillage= MaillagePrincipal } 
        { Modele= Interacteur } 
	
        { Modele= Geometres }
		
		{ Modele= CLMecanique } 	
		{ Modele= NavierStokes }
		{ Modele= UpdateV }
	
		{ Modele= CLThermique }
		{ Modele= ResolutionTemperature }
		{ Modele= UpdateT }
		  
	    { Modele= DeLaFonction }
      	{ Modele= Adaptateur }
		{ Modele= Geometres }
		{ Modele= Melange }
	   
	  	{ Modele= Sorties }
		{ Modele= GestionTemps }  
		
    } 
} 

{ GestionTemps=                              // T=T+dt jusqu'au T=Tfin

    { Type= ModeleTemporel }     

    { Data=         
        { NomTemps= Temps }         
        { NomPasDeTemps= PasDeTemps }  
    } 
    { DependanceModifiable= 
        { Champ= Temps } 
    } 
    { Dependance=         
        { Maillage= MaillagePrincipal }               
        { Champ= PasDeTemps }  
    } 
} 


{ Fin=                                      // on sort si T = Tfin
    { Type= ModeleFinSurTemps }     
    { Data=         
        { NomTemps= Temps }         
        { NomTempsFin= TempsFin }     
    }     
    { Dependance=         
        { Maillage= MaillagePrincipal }         
        { Champ= Temps }         
        { Champ= TempsFin }     
    } 
} 


