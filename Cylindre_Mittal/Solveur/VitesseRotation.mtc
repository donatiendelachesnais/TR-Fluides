{ PrepareDxDy=
    { Type= ModeleArithmetique }
    { Dependance= 
        { Maillage= MaillagePrincipal }
		{ Champ= Cox }
		{ Champ= Coy }
		{ Champ= x0 }
		{ Champ= y0 }
		{ Champ= omega }
    }
    { DependanceModifiable= 
        { Champ= Dx }
		{ Champ= Dy }
    }

    { Operation= Dx += Coy }
	{ Operation= Dx -= y0 }		
	{ Operation= Dx *= omega }		
	{ Operation= Dy += x0 }
	{ Operation= Dy -= Cox }
	{ Operation= Dy *= omega }
}